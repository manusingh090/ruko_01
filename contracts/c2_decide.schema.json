{
  "title": "RUKO C2: POST /v1/decide",
  "contract_version": "c2-0.8",
  "request": {
    "$defs": {
      "CallSignal": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Active"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "sim",
                  "voip"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kind"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "incoming",
                  "outgoing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Direction"
          },
          "caller_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Caller Number"
          },
          "caller_in_contacts": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Caller In Contacts"
          },
          "started_min_ago": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started Min Ago"
          },
          "ended_min_ago": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ended Min Ago"
          },
          "speaker_on": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Speaker On"
          }
        },
        "title": "CallSignal",
        "type": "object"
      },
      "Context": {
        "additionalProperties": false,
        "properties": {
          "call": {
            "anyOf": [
              {
                "$ref": "#/$defs/CallSignal"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "device": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeviceSignal"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "lures": {
            "items": {
              "$ref": "#/$defs/LureSignal"
            },
            "title": "Lures",
            "type": "array"
          },
          "episode": {
            "anyOf": [
              {
                "$ref": "#/$defs/EpisodeSignal"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/$defs/SessionSignal"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "payee_in_contacts": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Payee In Contacts"
          },
          "device_verdict": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeviceVerdict"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "title": "Context",
        "type": "object"
      },
      "DeviceSignal": {
        "additionalProperties": false,
        "properties": {
          "remote_access_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Remote Access Active"
          },
          "remote_app_installed_min_ago": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Remote App Installed Min Ago"
          },
          "untrusted_accessibility": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Untrusted Accessibility"
          },
          "sideloaded_last_24h": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sideloaded Last 24H"
          }
        },
        "title": "DeviceSignal",
        "type": "object"
      },
      "DeviceVerdict": {
        "additionalProperties": false,
        "description": "The phone's own model on what only the phone can see (c2-0.8; ml/model/device, DeviceModel.kt).\n\nCalls, apps, SMS (through the lure model), the episode, the Pay screen and the payment history\nare read on the phone and stay there; only this verdict leaves it. Family scores are 0..1,\nrounded to 2 decimals, and each counts only in its own family on the server (rule 5).",
        "properties": {
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "fraud_class": {
            "anyOf": [
              {
                "enum": [
                  "digital_arrest",
                  "fake_customer_care",
                  "fake_kyc_apk",
                  "trading_group",
                  "task_job",
                  "refund_qr"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fraud Class"
          },
          "level": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level",
            "type": "string"
          },
          "c": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "C"
          },
          "l": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "L"
          },
          "b": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "B"
          },
          "reasons": {
            "items": {
              "enum": [
                "R1_live_unknown_call",
                "R2_remote_control",
                "R3_mule_like_payee",
                "R4_unusual_amount",
                "R5_lure_message",
                "R6_new_payee_typed",
                "R7_tranche_pattern",
                "R8_intel_hit",
                "R9_story_mismatch",
                "R10_bait_then_pay",
                "R11_ring_link",
                "R12_coached_session",
                "ruko_unavailable"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "model_version",
          "level"
        ],
        "title": "DeviceVerdict",
        "type": "object"
      },
      "EpisodeSignal": {
        "additionalProperties": false,
        "description": "Task-scam episode kept on the phone across payees for up to 30 days (c2-0.3).\n\nBuilt by the phone's background watcher from bank SMS alerts and this app's payments, with\nthe rules in contracts/episode_rules.json. Counts only; bait fields are null when SMS can't be read.",
        "properties": {
          "state": {
            "enum": [
              "none",
              "watching",
              "active",
              "dismissed"
            ],
            "title": "State",
            "type": "string"
          },
          "age_days": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Age Days"
          },
          "bait_credits": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bait Credits"
          },
          "bait_inr": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bait Inr"
          },
          "outs": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Outs"
          },
          "outs_inr": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Outs Inr"
          },
          "new_payees": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "New Payees"
          },
          "escalation_steps": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Escalation Steps"
          },
          "last_out_inr": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Last Out Inr"
          },
          "out_to_in_ratio": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Out To In Ratio"
          },
          "payee_seen_in_episode": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Payee Seen In Episode"
          },
          "rules_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rules Version"
          }
        },
        "required": [
          "state"
        ],
        "title": "EpisodeSignal",
        "type": "object"
      },
      "LureSignal": {
        "additionalProperties": false,
        "properties": {
          "tag": {
            "enum": [
              "arrest_threat",
              "kyc",
              "task_job",
              "trading_tip",
              "refund",
              "normal"
            ],
            "title": "Tag",
            "type": "string"
          },
          "conf": {
            "maximum": 1,
            "minimum": 0,
            "title": "Conf",
            "type": "number"
          },
          "min_ago": {
            "minimum": 0,
            "title": "Min Ago",
            "type": "number"
          }
        },
        "required": [
          "tag",
          "conf",
          "min_ago"
        ],
        "title": "LureSignal",
        "type": "object"
      },
      "SessionSignal": {
        "additionalProperties": false,
        "description": "How the user behaved on the Pay screen of THIS payment (c2-0.5).\n\nMeasured inside the app, from opening Pay to tapping Pay. Only counts and rounded durations:\nnever the keys typed, never which other app was open. Field meanings: contracts/README.md.",
        "properties": {
          "amount_digits": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount Digits"
          },
          "amount_median_gap_s": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount Median Gap S"
          },
          "amount_max_gap_s": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount Max Gap S"
          },
          "amount_gap_vs_usual": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount Gap Vs Usual"
          },
          "amount_edits": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount Edits"
          },
          "payee_pasted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Payee Pasted"
          },
          "pasted_within_s_of_return": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pasted Within S Of Return"
          },
          "app_switches": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "App Switches"
          },
          "away_s": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Away S"
          },
          "pay_screen_s": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pay Screen S"
          },
          "abandoned_flows_30m": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Abandoned Flows 30M"
          }
        },
        "title": "SessionSignal",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "request_id": {
        "title": "Request Id",
        "type": "string"
      },
      "user_id": {
        "title": "User Id",
        "type": "string"
      },
      "payee_upi_id": {
        "title": "Payee Upi Id",
        "type": "string"
      },
      "amount_inr": {
        "exclusiveMinimum": 0,
        "title": "Amount Inr",
        "type": "number"
      },
      "entry_method": {
        "enum": [
          "typed",
          "qr",
          "contact",
          "collect"
        ],
        "title": "Entry Method",
        "type": "string"
      },
      "payer_says": {
        "anyOf": [
          {
            "enum": [
              "government",
              "company",
              "family",
              "shop",
              "investment",
              "other"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Payer Says"
      },
      "ts": {
        "format": "date-time",
        "title": "Ts",
        "type": "string"
      },
      "context": {
        "anyOf": [
          {
            "$ref": "#/$defs/Context"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "request_id",
      "user_id",
      "payee_upi_id",
      "amount_inr",
      "entry_method",
      "ts"
    ],
    "title": "DecideRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "Threat": {
        "additionalProperties": false,
        "description": "The server's threat analysis of this payment (c2-0.8): every family, the phone's verdict,\npayee intel (bank features, MuleHunter, FRI, I4C registry) and the payment graph.",
        "properties": {
          "score": {
            "maximum": 100,
            "minimum": 0,
            "title": "Score",
            "type": "integer"
          },
          "level": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Level",
            "type": "string"
          },
          "fraud_type": {
            "anyOf": [
              {
                "enum": [
                  "digital_arrest",
                  "fake_customer_care",
                  "fake_kyc_apk",
                  "trading_group",
                  "task_job",
                  "refund_qr"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fraud Type"
          },
          "families": {
            "items": {
              "enum": [
                "C",
                "L",
                "P",
                "B"
              ],
              "type": "string"
            },
            "title": "Families",
            "type": "array"
          }
        },
        "required": [
          "score",
          "level"
        ],
        "title": "Threat",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "request_id": {
        "title": "Request Id",
        "type": "string"
      },
      "tier": {
        "enum": [
          "T0",
          "T1",
          "T2",
          "T3",
          "T4"
        ],
        "title": "Tier",
        "type": "string"
      },
      "reasons": {
        "items": {
          "enum": [
            "R1_live_unknown_call",
            "R2_remote_control",
            "R3_mule_like_payee",
            "R4_unusual_amount",
            "R5_lure_message",
            "R6_new_payee_typed",
            "R7_tranche_pattern",
            "R8_intel_hit",
            "R9_story_mismatch",
            "R10_bait_then_pay",
            "R11_ring_link",
            "R12_coached_session",
            "ruko_unavailable"
          ],
          "type": "string"
        },
        "title": "Reasons",
        "type": "array"
      },
      "message_key": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Message Key"
      },
      "pause_minutes": {
        "default": 0,
        "title": "Pause Minutes",
        "type": "integer"
      },
      "playbook": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Playbook"
      },
      "stage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Stage"
      },
      "evidence_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Evidence Id"
      },
      "fail_open": {
        "default": false,
        "title": "Fail Open",
        "type": "boolean"
      },
      "contract_version": {
        "default": "c2-0.8",
        "title": "Contract Version",
        "type": "string"
      },
      "threat": {
        "anyOf": [
          {
            "$ref": "#/$defs/Threat"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "request_id",
      "tier",
      "reasons"
    ],
    "title": "DecideResponse",
    "type": "object"
  }
}
